DATABASE_URL=

# Public base URL of this backend, no trailing slash. Used to build stable
# recording links and locally-served fallback videos.
# e.g. https://your-app.onrender.com
PUBLIC_URL=http://localhost:4000

# Cloudflare R2 (optional — leave empty to keep merged videos on local disk).
# Buckets are private; recordings are served via short-lived presigned URLs
# minted by GET /api/recordings/file/:meetingId, so no public bucket is needed.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=
